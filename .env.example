# ==========================================
# NEXUS LMS - VARIÁVEIS DE AMBIENTE
# ==========================================

# 1. Banco de Dados PostgreSQL (Supabase)
# Copie do painel do Supabase: Project Settings -> Database -> Connection string
# Na Vercel, utilize a URL com Connection Pooling (porta 6543):
DATABASE_URL="postgresql://postgres.[SEU-PROJECT-REF]:[SUA-SENHA]@aws-0-[REGIAO].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Para migrações diretas do Prisma CLI (porta 5432):
DIRECT_URL="postgresql://postgres.[SEU-PROJECT-REF]:[SUA-SENHA]@aws-0-[REGIAO].pooler.supabase.com:5432/postgres"

# 2. Segurança & Autenticação JWT
# Pode ser qualquer hash aleatório longo
JWT_SECRET="nexus-lms-super-secret-jwt-key-production-change-me"

# 3. Supabase Storage (Upload de Capas em Nuvem)
# Obtenha em: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://[SEU-PROJECT-REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="sua-service-role-key-aqui"
SUPABASE_STORAGE_BUCKET="lms-uploads"
